{
  "name": "binance-mcp-server",
  "version": "2.0.0",
  "description": "MCP server for Binance market data and trading integration",
  "main": "dist/index.js",
  "bin": {
    "binance-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "nodemon --exec tsx src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "binance",
    "mcp",
    "claude",
    "trading",
    "api"
  ],
  "author": "Ethan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethancod1ng/binance-mcp-server.git"
  },
  "homepage": "https://github.com/ethancod1ng/binance-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/ethancod1ng/binance-mcp-server/issues"
  },
  "files": [
    "dist",
    "README.md",
    "docs/README_zh.md",
    "docs/README_ja.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "binance-api-node": "^0.13.10",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
